# PostgreSQL connection string (pooled).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB_NAME?sslmode=require"

# Direct connection for Prisma migrations.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DB_NAME?sslmode=require"

# Public URL of this API (used for upload links).
API_PUBLIC_URL="http://localhost:3000"

# Shared secret with frontend NEXT_PUBLIC_PROJECT_TOKEN.
API_SECRET="your_local_dev_token"

# Comma-separated allowed frontend origins.
CORS_ORIGINS="http://localhost:3001,http://127.0.0.1:3001"

# Port (optional, defaults to 3000).
PORT=3000

# development | production
NODE_ENV=development
