# PostgreSQL connection string (e.g. Neon, Supabase, Railway).
# Pooled connection — used by the Prisma Client at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB_NAME?sslmode=require"

# Direct (unpooled) connection — used by Prisma for migrations.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DB_NAME?sslmode=require"

# Port the API listens on (optional, defaults to 3000).
PORT=3000
